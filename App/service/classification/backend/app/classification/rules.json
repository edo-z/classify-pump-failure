{
  "version": "1.1",
  "description": "Threshold rules for pump trouble classification. Tier 3000 l/s fully defined.",
  "tiers": {
    "3000": {
      "rules": {
        "POMPA_TERSANGKUT_SAMPAH": {
          "conditions": [
            {
              "field": "output_frequency",
              "op": "<=",
              "value": 10,
              "unit": "Hz",
              "note": "PTS_F"
            },
            {
              "field": "output_power",
              "op": ">=",
              "value": 250,
              "unit": "kW",
              "note": "PTS_KW ref 250"
            },
            {
              "field": "motor_current",
              "op": ">=",
              "value": 517,
              "unit": "A",
              "note": "PTS_A ref 517"
            },
            {
              "field": "motor_torque",
              "op": ">=",
              "value": 110,
              "unit": "%",
              "note": "PTS_T ref 110%"
            },
            {
              "field": "motor_speed",
              "op": ">=",
              "value": 100,
              "unit": "RPM",
              "note": "PTS_RPM ref 100"
            }
          ],
          "logic": "PTS_F AND (PTS_Count>=3) tanpa MEAN per-sample",
          "description": "Pompa tersangkut sampah (PTS: freq<=10 and >=3 dari 4: kW/A/Torque/RPM)"
        },
        "TURBULENSI": {
          "conditions": [
            {
              "field": "output_frequency",
              "op": "not_reaching_setpoint",
              "ref": "setpoint_freq",
              "unit": "Hz",
              "note": "T_Freq"
            },
            {
              "field": "output_power",
              "op": ">=",
              "value": 250,
              "unit": "kW",
              "note": "T_KW ref 250"
            },
            {
              "field": "motor_current",
              "op": "deviation_from_ma",
              "window": 30,
              "threshold": 10.0,
              "unit": "A",
              "note": "T_A |A-MA30|>=10"
            },
            {
              "field": "motor_torque",
              "op": ">=",
              "value": 90,
              "unit": "%",
              "note": "T_T ref 90%"
            }
          ],
          "logic": "AND_STRICT_4_4",
          "description": "Turbulensi (T_Freq AND T_KW AND T_A MA30 AND T_T, strict 4/4)"
        },
        "BANYAK_SAMPAH": {
          "conditions": [
            {
              "field": "output_frequency",
              "op": "not_exceeding_setpoint",
              "ref": "setpoint_freq",
              "unit": "Hz",
              "note": "BS_F Freq<=setpoint"
            },
            {
              "field": "output_power",
              "op": ">=",
              "value": 250,
              "unit": "kW",
              "note": "BS_kW ref 250"
            },
            {
              "field": "motor_current",
              "op": ">=",
              "value": 517,
              "unit": "A",
              "note": "BS_A ref 517"
            },
            {
              "field": "motor_torque",
              "op": ">=",
              "value": 90,
              "unit": "%",
              "note": "BS_T ref 90%"
            }
          ],
          "logic": "AND",
          "description": "Banyak sampah (BS_F Freq<=sp AND BS_kW>=ref AND BS_A>=ref AND BS_T>=90, strict 4/4)"
        },
        "DRY_RUN": {
          "conditions": [
            {
              "field": "output_frequency",
              "op": "==",
              "ref": "setpoint_freq",
              "unit": "Hz",
              "note": "DR_F F==sp raw 2 desimal",
              "group": "DR_F"
            },
            {
              "field": "output_power",
              "op": "<=",
              "value": 166.75,
              "unit": "kW",
              "note": "DR_kW = 0.667 * 250 (tier POMPA ref)",
              "group": "DR_C"
            },
            {
              "field": "motor_current",
              "op": "<=",
              "value": 330.88,
              "unit": "A",
              "note": "DR_A = 0.64 * 517 (tier POMPA ref)",
              "group": "DR_C"
            },
            {
              "field": "motor_torque",
              "op": "<",
              "value": 70,
              "unit": "%",
              "group": "DR_C"
            }
          ],
          "logic": "AND_STRICT_4_4",
          "description": "DryRun 2 tingkat: DR_F (F==sp raw 2des) + DR_C (0.667*ref kW + 0.64*ref A + torque<70)",
          "freq_sustain": 1,
          "count_trigger": 1
        }
      }
    },
    "panel_overheat": {
