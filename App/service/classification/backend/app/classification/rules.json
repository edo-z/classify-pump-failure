  "capability_rules": {
    "UNBALANCE": {
      "method": "max_phase_deviation_from_average",
      "operator": ">=",
      "threshold_pct": 10.0
    },
    "UNDERVOLTAGE": {
      "field": "input_voltage",
      "operator": "<",
      "threshold_v": 360.0
    },
    "OVERVOLTAGE": {
      "field": "input_voltage",
      "operator": ">",
      "threshold_v": 410.0
    }
  }
