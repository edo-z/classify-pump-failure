# Classification document storage
CLASSIFICATION_INPUT_DIR=/home/aldo/Documents/Agent-Maintenance/Data/classification-input

# Normalized classification document storage
CLASSIFICATION_NORMALIZED_DIR=/home/aldo/Documents/Agent-Maintenance/Data/classification-normalized

# API key konsumen luar (tim BE) via header X-API-Key.
# Kosong = terbuka (DEV saja); isi di produksi.
CLASSIFICATION_API_KEY=

# DB ingest worker (Tahap 2, baca telemetry + tulis raw_classifications).
# Belum ada tulisan ke production sebelum disepakati; default menunjuk lokal.
CLASSIFICATION_DB_HOST=127.0.0.1
CLASSIFICATION_DB_PORT=3306
CLASSIFICATION_DB_USER=root
CLASSIFICATION_DB_PASSWORD=
CLASSIFICATION_DB_NAME=dexmin
# Interval polling tick (detik). Dedup event-time yang menjaga buffer,
# bukan cadence terkunci — polling boleh sering.
INGEST_INTERVAL_S=5
# Batas freshness antarparameter (detik). Default bila kosong: 2x interval.
INGEST_FRESHNESS_S=
# Override mapping parameter_definitions.key -> field kanonis (JSON opsional).
# Key final dikunci setelah SELECT DISTINCT key di MySQL 8.4.x production.
# Contoh: CLASSIFICATION_DB_KEYMAP={"freq_hz": "output_frequency"}
CLASSIFICATION_DB_KEYMAP=
