  "rules": [
    {
      "order": 1,
      "id": "pompa_tersangkut_sampah",
      "name": "Pompa tersangkut sampah",
      "logic": "Frekuensi rendah plus minimal tiga dari empat tanda beban. Diperiksa pertama.",
      "thresholds": [
        "Frekuensi ≤ 10 Hz",
        "Daya ≥ 400 kW",
        "Arus ≥ 867 A",
        "Torsi ≥ 110%",
        "Putaran ≥ 100 RPM"
      ]
    },
    {
      "order": 2,
      "id": "turbulensi",
      "name": "Turbulensi",
      "logic": "Frekuensi tidak mencapai setpoint dan arus menyimpang dari rata-rata historis.",
      "thresholds": [
        "Frekuensi < setpoint 40 Hz",
        "Daya ≥ 400 kW",
        "|Arus − MA30| ≥ 10 A",
        "Torsi ≥ 90%"
      ]
    },
    {
      "order": 3,
      "id": "banyak_sampah",
      "name": "Banyak sampah",
      "logic": "Frekuensi tertahan di setpoint dengan daya, arus, dan torsi di atas acuan.",
      "thresholds": [
        "Frekuensi ≤ setpoint 40 Hz",
        "Daya ≥ 400 kW",
        "Arus ≥ 867 A",
        "Torsi ≥ 90%"
      ]
    },
    {
      "order": 4,
      "id": "dry_run",
      "name": "Dry run",
      "logic": "Frekuensi tepat di setpoint, tetapi daya, arus, dan torsi berada di bawah beban normal.",
      "thresholds": [
        "Frekuensi = setpoint 40 Hz, 2 desimal",
        "Daya ≤ 266,8 kW",
        "Arus ≤ 554,88 A",
        "Torsi < 70%"
      ]
    },
    {
      "order": 5,
      "id": "panel_overheat",
      "name": "Panel overheat",
      "logic": "Suhu panel di atas ambang pada salah satu dari tiga titik ukur.",
      "thresholds": [
        "Ambient ≥ 60 °C",
        "Control board ≥ 60 °C",
        "Inverter ≥ 60 °C"
      ]
    },
    {
      "order": 6,
      "id": "unbalance",
      "name": "Unbalance",
      "logic": "Satu fase menyimpang dari rata-rata arus tiga fase. Tidak memakai riwayat.",
      "thresholds": [
        "Deviasi fasa maksimum ≥ 10%"
      ]
    },
    {
      "order": 7,
      "id": "undervoltage",
      "name": "Undervoltage",
      "logic": "Tegangan masukan berada di bawah batas operasi.",
      "thresholds": [
        "Tegangan < 360 V"
      ]
    },
    {
      "order": 8,
      "id": "overvoltage",
      "name": "Overvoltage",
      "logic": "Tegangan masukan berada di atas batas operasi.",
      "thresholds": [
        "Tegangan > 410 V"
      ]
    }
  ],
