# Konfigurasi backend klasifikasi Node.js (Fastify + Socket.IO, :3031).
# Salin ke `.env` / set lewat systemd Environment= (JANGAN commit `.env` asli).

HOST=127.0.0.1
PORT=3031

# Kunci API konsumen HTTP via header X-API-Key.
# Kosong = terbuka (DEV saja); WAJIB diisi untuk akses publik/produksi.
CLASSIFICATION_API_KEY=

# Bridge telemetri DEX (opsional; kosong = bridge dilewati).
DEX_SOCKET_URL=https://www.dexindonesia.com
DEX_SOCKET_TOKEN=4892|kZz4Da0vKk6s00djwPaYp6Wu32hm57PhdpLbff0Y45317251
DEX_PUMP_ID=21
DEX_TIMESTAMP_OFFSET=+07:00

# Opsional: origin browser yang diizinkan untuk Socket.IO.
CLASSIFICATION_SOCKET_ORIGIN=https://classify.aldozeno.my.id

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dexmin
DB_POOL_LIMIT=10

# Retry buffer (persistence)
REALTIME_RETRY_BASE_MS=1000
REALTIME_RETRY_MAX_MS=30000
REALTIME_RETRY_BUFFER_MAX=2048

# Test database (hanya untuk npm run test:integration; NAMA HARUS AKHIR _test)
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASSWORD=
TEST_DB_NAME=dexmin_test
