# Konfigurasi backend klasifikasi Node.js (Fastify + Socket.IO, :3031).
# Salin ke `.env` / set lewat systemd Environment= (JANGAN commit `.env` asli).

HOST=127.0.0.1
PORT=3031

# Kunci API konsumen HTTP via header X-API-Key.
# Kosong = terbuka (DEV saja); WAJIB diisi untuk akses publik/produksi.
CLASSIFICATION_API_KEY=

# Bridge telemetri DEX (opsional; kosong = bridge dilewati).
DEX_SOCKET_URL=https://www.dexindonesia.com
DEX_SOCKET_TOKEN=
DEX_PUMP_ID=21
DEX_TIMESTAMP_OFFSET=+07:00

# Opsional: origin browser yang diizinkan untuk Socket.IO.
CLASSIFICATION_SOCKET_ORIGIN=
