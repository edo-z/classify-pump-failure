{
  "name": "classification-backend-node",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js (TypeScript + Fastify) behavioral-equivalent port of the Python classification engine.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "node src/server.ts",
    "test": "node --test test/unit/ test/golden/ test/differential/ test/socket/",
    "test:unit": "node --test test/unit/",
    "test:golden": "node --test test/golden/",
    "test:differential": "node --test test/differential/",
    "test:socket": "node --test test/socket/"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "dotenv": "^18.0.8",
    "fastify": "^5.2.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.7.3"
  }
}
